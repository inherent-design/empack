# Copy this file to .env.local for optional local configuration
# Never commit .env.local

# Modrinth catalog requests use the public API and need no credentials

# CurseForge uses empack's bundled client key by default.
# Uncomment to override it for application catalog queries and authorized downloads.
# Export EMPACK_KEY_CURSEFORGE when overriding the isolated live verification suites.
# EMPACK_KEY_CURSEFORGE=

# Optional debug logging (0=error, 1=warn, 2=info, 3=debug, 4=trace)
# EMPACK_LOG_LEVEL=3
