{
  "$schema": "https://dprint.dev/schemas/v0.json",
  "indentWidth": 2,
  "lineWidth": 120,
  "useTabs": false,
  "newLineKind": "lf",
  "markdown": {
    "textWrap": "never",
    "emphasisKind": "asterisks",
    "strongKind": "asterisks"
  },
  "includes": [
    "**/*.md"
  ],
  "excludes": [
    "**/node_modules/**",
    "**/build/**",
    "**/dist/**",
    "**/target/**",
    "**/.gradle/**",
    "**/artifacts/**",
    "**/.git/**"
  ],
  "plugins": [
    "https://plugins.dprint.dev/markdown-0.21.1.wasm"
  ]
}
